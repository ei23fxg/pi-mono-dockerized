#!/usr/bin/env bash

if [ -z "${BASH_VERSION:-}" ]; then
    echo "Error: This script requires bash. Please run with: bash $0" >&2
    exit 1
fi

set -euo pipefail

# --- Konfiguration ---
PI_SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

CURRENT_DIR_HASH=$(printf '%s' "$PWD" | md5sum | cut -d' ' -f1)
CURRENT_DIR_HASH_SHORT="${CURRENT_DIR_HASH: -6}"
PROJECT_NAME="$(basename "$(pwd)")"
PI_WORK_DIR="/${PROJECT_NAME}_${CURRENT_DIR_HASH_SHORT}"

# Pi encodiert den Container-Pfad für seinen Session-Ordner:
# führender Slash weg, "/" und ":" werden zu "-".
PI_SAFE_WORK_DIR="${PI_WORK_DIR#/}"
PI_SAFE_WORK_DIR="${PI_SAFE_WORK_DIR//\//-}"
PI_SAFE_WORK_DIR="${PI_SAFE_WORK_DIR//:/-}"
PI_SAFE_WORK_DIR="${PI_SAFE_WORK_DIR//\\/-}"

PI_DOCKER_CONFIG_ROOT="$HOME/.pi"
PI_API_KEY_FILES=(ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY GROQ_API_KEY XAI_API_KEY HF_TOKEN GH_TOKEN GITHUB_TOKEN)
PI_CONTAINER_NAME_PREFIX="pi-"
PI_CONTAINER_NAME="${PI_CONTAINER_NAME_PREFIX}${CURRENT_DIR_HASH}"
PI_IMAGE_NAME="pi:latest"
PI_FOLDER="$HOME/.pi"
PI_AGENT_DIR="${PI_FOLDER}/agent"
PI_MOUNTS_FILE="${PI_MOUNTS_FILE:-${PI_FOLDER}/mounts.conf}"
PI_SESSION_MOUNT_NAME="--${PI_SAFE_WORK_DIR}--"
PI_SESSION_DIR="${PI_AGENT_DIR}/sessions/${PI_SESSION_MOUNT_NAME}"
PI_GLOBAL_VOLUME="pi-software-binaries"

# Festes Arbeits-Home für Pi. Es wird beim Start angelegt und über einen
# verwalteten Eintrag in mounts.conf nach /home/hostuser/pi-home gemountet.
PI_HOME_DIR="${PI_HOME_DIR:-$HOME/pi-home}"
PI_HOME_OLD_DEFAULT="$HOME/documents/pi-home"
PI_HOME_CONTAINER="/home/hostuser/pi-home"
PI_HOME_HASH=$(printf '%s' "$PI_HOME_DIR" | md5sum | cut -d' ' -f1)
PI_HOME_ID="${PI_HOME_HASH: -6}"
PI_HOME_CONTAINER_NAME="pi-home-${PI_HOME_ID}"
PI_HOME_SESSION_NAME="--pi-home-${PI_HOME_ID}--"
PI_HOME_SESSION_DIR="${PI_AGENT_DIR}/sessions/${PI_HOME_SESSION_NAME}"
# Nur mit "pi -m" wird das aktuelle Verzeichnis als Projekt gemountet.
# "pi -m DATEI..." mountet stattdessen nur die genannten Dateien.
PI_MOUNT_CWD="${PI_MOUNT_CWD:-0}"
PI_SELECTIVE=0
PI_MOUNT_FILE_HOSTS=()
PI_MOUNT_FILE_TARGETS=()

# Aktuelle Pi-Version (nicht mehr das alte @mariozechner-Paket).
# Per Umgebung überschreibbar, z. B. PI_CODING_AGENT_VERSION=1.6.0
PI_CODING_AGENT_VERSION="${PI_CODING_AGENT_VERSION:-1.5.2}"
PI_CODING_AGENT_SPEC="@earendil-works/pi-coding-agent@${PI_CODING_AGENT_VERSION}"
PI_LEGACY_PACKAGE="@mariozechner/pi-coding-agent"
# Standard-Pakete. Bewusst OHNE exakte Versionspin: Pi prüft beim Start gegen
# die Registry und meldet dann im Chat
#     "Package Updates Available - Run pi update --extensions"
# Gepinnte Einträge (npm:name@1.2.3) überspringt genau diese Prüfung, und
# "pi update" verschiebt sie nie (docs/packages.md: "Versioned npm
# specifications are pinned."). Fliegend eingetragene Pakete bleiben auch nach
# einem Update fliegend, die Meldung erscheint also wieder.
#
#   pi update --extensions   nur Pakete aktualisieren
#   pi update --all          Pi und alle Pakete aktualisieren
#
# Wer trotzdem reproduktiv fixieren will, pinnt (dann entfällt die Meldung):
#   PI_PACKAGE_PINS="pi-web-access@0.47.0,pi-webapp@0.1.55" pi ...
# Ein einzelnes Paket unterdrücken: PI_SKIP_PACKAGES="billion-context" pi ...
PI_DEFAULT_PACKAGE_NAMES=(pi-web-access pi-webapp pi-token-speed billion-context pi-context-view)
PI_PACKAGE_PINS="${PI_PACKAGE_PINS:-}"
PI_SKIP_PACKAGES="${PI_SKIP_PACKAGES:-}"
PI_DEFAULT_PACKAGES=()
for _pkg_name in "${PI_DEFAULT_PACKAGE_NAMES[@]}"; do
    _pkg_pin=""
    _skip=0
    _saved_ifs="$IFS"; IFS=','
    for _pin_spec in ${PI_PACKAGE_PINS}; do
        [[ "${_pin_spec%%@*}" == "${_pkg_name}" ]] && _pkg_pin="${_pin_spec#*@}"
    done
    for _skip_name in ${PI_SKIP_PACKAGES}; do
        [[ "${_skip_name}" == "${_pkg_name}" ]] && _skip=1
    done
    IFS="${_saved_ifs}"
    [[ "${_skip}" == "1" ]] && continue
    PI_DEFAULT_PACKAGES+=("npm:${_pkg_name}${_pkg_pin:+@${_pkg_pin}}")
done
unset _pkg_name _pkg_pin _pin_spec _skip _skip_name _saved_ifs
PI_PACKAGES_STAMP="2026-11-12-context-view"

# billion-context (Kontextkompression): Session-Records und Konfiguration dürfen
# nicht im flüchtigen Container-$HOME landen.
PI_BILI_DATA_DIR="${PI_AGENT_DIR}/billion-context"

# Pi läuft immer im Docker-Host-Netzwerk, damit das Web-UI (127.0.0.1 im
# Container) vom Host-Browser erreichbar ist. Kein bridge-Override.
PI_NETWORK_MODE="host"

# .git ist standardmäßig sichtbar, damit Pi lokal committen kann.
# Mit PI_ALLOW_GIT=0 werden .git, .gitignore und .gitmodules verborgen.
PI_ALLOW_GIT="${PI_ALLOW_GIT:-1}"

# Mit PI_SHOW_HIDDEN=1 (oder "pi --show-hidden") werden alle standardmäßig
# versteckten Projektdateien sichtbar. Es wird nichts außerhalb des Projekts
# und der mounts.conf-Einträge eingebunden.
PI_SHOW_HIDDEN="${PI_SHOW_HIDDEN:-0}"

# Git-Identität: aus der Host-Konfiguration übernehmen, per Umgebung
# überschreibbar. Ohne Namen/E-Mail kann git keinen Commit erzeugen.
PI_GIT_NAME="${PI_GIT_NAME:-$(git config --global user.name 2>/dev/null || true)}"
PI_GIT_EMAIL="${PI_GIT_EMAIL:-$(git config --global user.email 2>/dev/null || true)}"

# Diese Variablen gelten für jeden Pi-/npm-Aufruf im Container.
PI_TELEMETRY_ENV=(
    -e "PI_TELEMETRY=0"
    -e "PI_WEB_SENTRY_ENABLED=false"
    -e "PI_WEBAPP_AUTO_OPEN=0"
    -e "DO_NOT_TRACK=1"
    -e "NPM_CONFIG_UPDATE_NOTIFIER=false"
)

# npm-Cache außerhalb von $HOME halten; sonst legt die Update-Prüfung
# ~/.npm im gemounteten Pi-Home an. Das Volume ist bereits persistent.
PI_NPM_ENV=(
    -e "npm_config_cache=/opt/pi-packages/npm-cache"
    -e "NPM_CONFIG_CACHE=/opt/pi-packages/npm-cache"
)

# Rust-Version für das Image (per Umgebung überschreibbar, z. B. PI_RUST_VERSION=1.83)
PI_RUST_VERSION="${PI_RUST_VERSION:-stable}"
# Ändert sich der Stamp (Dockerfile/Rust-Version), wird das Image automatisch neu gebaut
PI_BUILD_STAMP="6-${PI_RUST_VERSION}"

PI_DEFAULT_IGNORED_FILES=(.env .deploy .secret .git .build .vscode .gitmodules .pi .aiignore .aiexclude .copilotignore .gitignore .geminiignore .codeiumignore .cursorignore .DS_Store)
PI_EMPTY_DIR=$(mktemp -d)
# Temporary sessions root with only this project's subdirectory. Mounting it
# over ~/.pi/agent/sessions hides every other project while keeping Pi's
# normal <sessions>/<encoded-cwd> layout (Web UI session discovery relies on it).
PI_SESSION_PARENT=$(mktemp -d)
mkdir -p "${PI_SESSION_PARENT}/${PI_SESSION_MOUNT_NAME}"
PI_HOME_SESSION_PARENT=$(mktemp -d)
mkdir -p "${PI_HOME_SESSION_PARENT}/${PI_HOME_SESSION_NAME}"
# Enthält nur .pi/APPEND_SYSTEM.md und .pi/SYSTEM.md, damit diese sichtbar
# bleiben, während der Rest des Projekt-.pi-Verzeichnisses verborgen ist.
PI_PROJECT_PI_DIR=$(mktemp -d)
# Leeres Projekt-Root für selektive Datei-Mounts und eigener Session-Root.
PI_FILES_ROOT=$(mktemp -d)
PI_SELECTIVE_SESSION_PARENT=$(mktemp -d)

cleanup() {
    rm -rf "$PI_EMPTY_DIR" "$PI_SESSION_PARENT" "$PI_HOME_SESSION_PARENT" "$PI_PROJECT_PI_DIR" "$PI_FILES_ROOT" "$PI_SELECTIVE_SESSION_PARENT" 2>/dev/null || true
}
trap cleanup EXIT

# ---------------------------------------------------------------------------
# Helper: Docker Image bauen
# ---------------------------------------------------------------------------
build_image() {
    echo "Building pi base image (Rust: ${PI_RUST_VERSION})..."
    TEMP_BUILD_DIR=$(mktemp -d)
    cat > "${TEMP_BUILD_DIR}/Dockerfile" <<EOF
FROM node:22-bookworm-slim

# Grundlegende System- & Dev-Tools
RUN DEBIAN_FRONTEND=noninteractive apt-get update && apt-get install -y --no-install-recommends \\
    bash openssh-server curl wget git gh make gcc g++ gawk ripgrep jq ca-certificates \\
    less procps unzip zip shellcheck \\
    ffmpeg imagemagick pandoc \\
    python3 python3-pip python3-venv python3-full \\
    golang \\
    php-cli php-mbstring php-xml php-curl php-mysql php-zip composer \\
    default-mysql-client \\
    pkg-config libssl-dev cmake clang lld libclang-dev zlib1g-dev \\
    && rm -rf /var/lib/apt/lists/*

# python -> python3 (Kompatibilität für Tools/Install-Skripte)
RUN ln -sf /usr/bin/python3 /usr/bin/python

# pnpm (muss vor dem NPM-Prefix für das Volume installiert werden)
RUN npm install -g pnpm@latest

# Rust systemweit über rustup
ARG RUST_VERSION=${PI_RUST_VERSION}
ENV RUSTUP_HOME=/usr/local/rustup \\
    CARGO_HOME=/usr/local/cargo \\
    PATH="/usr/local/cargo/bin:\${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \\
      | sh -s -- -y --no-modify-path --profile minimal --default-toolchain "\${RUST_VERSION}" \\
    && rustup component add rustfmt clippy \\
    && chmod -R a+w /usr/local/rustup /usr/local/cargo \\
    && rustc --version && cargo --version

# uv (Python-Paketmanager)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Pfade für das persistente SOFTWARE-Volume
ENV NPM_CONFIG_PREFIX=/opt/pi-packages/npm
ENV PYTHONUSERBASE=/opt/pi-packages/python
ENV GOPATH=/opt/pi-packages/go
ENV PATH="/opt/pi-packages/npm/bin:/opt/pi-packages/python/bin:/opt/pi-packages/go/bin:/usr/local/cargo/bin:/usr/local/bin:\${PATH}"
ENV PIP_USER=true
ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN mkdir -p /home/hostuser/.pi /opt/pi-packages/npm /opt/pi-packages/python /opt/pi-packages/go \\
    && chmod -R 777 /home/hostuser /opt/pi-packages \\
    && chmod 777 /
EOF
    docker build \
        --label "pi.build.stamp=${PI_BUILD_STAMP}" \
        --label "pi.managed=true" \
        --build-arg "RUST_VERSION=${PI_RUST_VERSION}" \
        -t "${PI_IMAGE_NAME}" \
        -f "${TEMP_BUILD_DIR}/Dockerfile" \
        "${TEMP_BUILD_DIR}"
    rm -rf "${TEMP_BUILD_DIR}"
}

# ---------------------------------------------------------------------------
# Helper: Host-Konfiguration in ~/.pi/agent anlegen (nichts überschreiben)
# ---------------------------------------------------------------------------
seed_pi_config() {
    local example_dir="${PI_SCRIPT_DIR}/examples/pi/agent"
    local old_settings="${PI_FOLDER}/settings.json"
    local new_settings="${PI_AGENT_DIR}/settings.json"

    mkdir -p "${PI_AGENT_DIR}/skills" "${PI_SESSION_DIR}"

    # Migration aus der alten Wrapper-Version: ~/.pi/settings.json -> ~/.pi/agent/settings.json
    if [[ -f "${old_settings}" && ! -f "${new_settings}" ]]; then
        local old_content
        old_content="$(tr -d '[:space:]' < "${old_settings}" || true)"
        if [[ -z "${old_content}" || "${old_content}" == "{}" ]]; then
            if [[ -f "${example_dir}/settings.json" ]]; then
                cp "${example_dir}/settings.json" "${new_settings}"
                echo "Migrated empty ~/.pi/settings.json to ~/.pi/agent/settings.json with privacy defaults."
            fi
        else
            cp "${old_settings}" "${new_settings}"
            echo "Migrated ~/.pi/settings.json to ~/.pi/agent/settings.json. Review the privacy defaults in examples/pi/agent/settings.json."
        fi
    fi

    if [[ -d "${example_dir}" ]]; then
        [[ -f "${new_settings}" ]] || cp "${example_dir}/settings.json" "${new_settings}"
        [[ -f "${PI_AGENT_DIR}/mcp.json" ]] || cp "${example_dir}/mcp.json" "${PI_AGENT_DIR}/mcp.json"
        [[ -f "${PI_AGENT_DIR}/web-search.json" ]] || cp "${example_dir}/web-search.json" "${PI_AGENT_DIR}/web-search.json"
        if [[ ! -f "${PI_AGENT_DIR}/skills/llm-wiki/SKILL.md" ]]; then
            mkdir -p "${PI_AGENT_DIR}/skills/llm-wiki"
            cp "${example_dir}/skills/llm-wiki/SKILL.md" "${PI_AGENT_DIR}/skills/llm-wiki/SKILL.md"
        fi
        if [[ -f "${example_dir}/APPEND_SYSTEM.md" ]]; then
            if [[ ! -f "${PI_AGENT_DIR}/APPEND_SYSTEM.md" ]]; then
                cp "${example_dir}/APPEND_SYSTEM.md" "${PI_AGENT_DIR}/APPEND_SYSTEM.md"
            else
                # Migrate only the untouched template from the previous release.
                local legacy_append
                legacy_append="$(cat <<'EOF'
# Global instructions

<!--
Add persistent instructions for every Pi session here. Pi appends this file to
the system prompt (it does not replace Pi's built-in system prompt).
Keep it short, concrete, and free of secrets.
-->
EOF
)"
                if [[ "$(cat "${PI_AGENT_DIR}/APPEND_SYSTEM.md")" == "${legacy_append}" ]]; then
                    cp "${example_dir}/APPEND_SYSTEM.md" "${PI_AGENT_DIR}/APPEND_SYSTEM.md"
                    echo "Updated ~/.pi/agent/APPEND_SYSTEM.md with the container environment template."
                elif grep -qF 'the current working directory is mounted at ' "${PI_AGENT_DIR}/APPEND_SYSTEM.md"; then
                    cp "${example_dir}/APPEND_SYSTEM.md" "${PI_AGENT_DIR}/APPEND_SYSTEM.md"
                    echo "Updated ~/.pi/agent/APPEND_SYSTEM.md with the fixed-home environment template."
                elif grep -qF '/home/<user>/documents/pi-home' "${PI_AGENT_DIR}/APPEND_SYSTEM.md"; then
                    cp "${example_dir}/APPEND_SYSTEM.md" "${PI_AGENT_DIR}/APPEND_SYSTEM.md"
                    echo "Updated ~/.pi/agent/APPEND_SYSTEM.md with the new default Pi home path."
                fi
            fi
        fi
        if [[ ! -f "${PI_MOUNTS_FILE}" && -f "${PI_SCRIPT_DIR}/examples/pi/mounts.conf" ]]; then
            mkdir -p "$(dirname "${PI_MOUNTS_FILE}")"
            cp "${PI_SCRIPT_DIR}/examples/pi/mounts.conf" "${PI_MOUNTS_FILE}"
        fi
    else
        echo "Warning: ${example_dir} not found; Pi config was not seeded." >&2
    fi
}

# ---------------------------------------------------------------------------
# Helper: Pi selbst (aktuelle @earendil-works-Version) im Volume installieren
# ---------------------------------------------------------------------------
# $1 >= $2 (semver-artig über sort -V)
version_at_least() {
    [[ "$1" == "$2" ]] && return 0
    printf '%s\n%s\n' "$2" "$1" | sort -V -C
}

ensure_pi() {
    local pi_state installed_version pi_patched=""
    pi_state="$(docker run --rm \
        --user "$(id -u):$(id -g)" \
        -v "${PI_GLOBAL_VOLUME}:/opt/pi-packages" \
        "${PI_IMAGE_NAME}" \
        /bin/sh -c 'if [ -x /opt/pi-packages/npm/bin/pi ] && [ -f /opt/pi-packages/.pi-coding-agent-version ]; then cat /opt/pi-packages/.pi-coding-agent-version; fi
if grep -q "pi-docker-share-disabled" /opt/pi-packages/npm/lib/node_modules/@earendil-works/pi-coding-agent/dist/modes/interactive/interactive-mode.js 2>/dev/null; then echo PATCHED; fi' \
        2>/dev/null || true)"

    installed_version="$(printf '%s\n' "${pi_state}" | sed -n '1p')"
    if printf '%s\n' "${pi_state}" | grep -q '^PATCHED$'; then
        pi_patched="1"
    fi

    # PI_CODING_AGENT_VERSION ist die Untergrenze, kein Deckel: ein "pi update"
    # im Volume darf beim nächsten Start nicht zurückgedreht werden.
    if [[ -z "${pi_patched}" && -n "${installed_version}" ]] && version_at_least "${installed_version}" "${PI_CODING_AGENT_VERSION}"; then
        if [[ "${installed_version}" != "${PI_CODING_AGENT_VERSION}" ]]; then
            echo "Keeping Pi ${installed_version} from the volume (wrapper pin is ${PI_CODING_AGENT_VERSION})."
            docker run --rm \
                --user "$(id -u):$(id -g)" \
                -v "${PI_GLOBAL_VOLUME}:/opt/pi-packages" \
                "${PI_IMAGE_NAME}" \
                /bin/sh -c "printf '%s' '${installed_version}' > /opt/pi-packages/.pi-coding-agent-version"
        fi
        return
    fi

    if [[ -n "${pi_patched}" ]]; then
        echo "Restoring /share by reinstalling Pi ${PI_CODING_AGENT_VERSION}..."
    else
        echo "Installing Pi ${PI_CODING_AGENT_VERSION} into persistent volume..."
    fi
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        -e "HOME=/home/hostuser" \
        -v "${PI_GLOBAL_VOLUME}:/opt/pi-packages" \
        "${PI_TELEMETRY_ENV[@]}" \
        "${PI_NPM_ENV[@]}" \
        "${PI_IMAGE_NAME}" \
        /bin/sh -c "mkdir -p /opt/pi-packages/npm; npm uninstall -g ${PI_LEGACY_PACKAGE} >/dev/null 2>&1 || true; npm uninstall -g @earendil-works/pi-coding-agent >/dev/null 2>&1 || true; npm install -g --no-audit --no-fund '${PI_CODING_AGENT_SPEC}' && printf '%s' '${PI_CODING_AGENT_VERSION}' > /opt/pi-packages/.pi-coding-agent-version"
}

# ---------------------------------------------------------------------------
# Helper: Standard-Pi-Pakete einmalig installieren
# ---------------------------------------------------------------------------
install_default_packages() {
    local host_stamp="${PI_AGENT_DIR}/.dockerized-packages-${PI_PACKAGES_STAMP}"
    local container_stamp="/home/hostuser/.pi/agent/.dockerized-packages-${PI_PACKAGES_STAMP}"
    [[ -f "${host_stamp}" ]] && return

    echo "Installing default Pi packages (${PI_DEFAULT_PACKAGES[*]})..."
    echo "  later updates: pi update --extensions (Pi reports new versions at startup)"
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        -v "${PI_FOLDER}:/home/hostuser/.pi" \
        -v "${PI_GLOBAL_VOLUME}:/opt/pi-packages" \
        -e "HOME=/home/hostuser" \
        -e "PI_CODING_AGENT_DIR=/home/hostuser/.pi/agent" \
        "${PI_TELEMETRY_ENV[@]}" \
        "${PI_NPM_ENV[@]}" \
        "${PI_IMAGE_NAME}" \
        /bin/sh -c "set -e; for spec in ${PI_DEFAULT_PACKAGES[*]}; do pi install \"\$spec\"; done; touch '${container_stamp}'"

    # Alte Stamp-Marker aufräumen (nur eigene Marker).
    find "${PI_AGENT_DIR}" -maxdepth 1 -name '.dockerized-packages-*' \
        ! -name ".dockerized-packages-${PI_PACKAGES_STAMP}" -delete 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Helper: zusätzliche permanente Mounts aus ~/.pi/mounts.conf
# ---------------------------------------------------------------------------
add_extra_mounts() {
    [[ -f "${PI_MOUNTS_FILE}" ]] || return

    local line host_path container_spec container_path mode
    while IFS= read -r line || [[ -n "${line}" ]]; do
        # Leerzeichen am Rand entfernen; Kommentare und Leerzeilen ignorieren.
        line="${line%$'\r'}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "${line}" || "${line}" == \#* ]] && continue

        # Nur ein führendes ~ wird expandiert.
        line="${line/#\~/$HOME}"

        if [[ "${line}" != *:* ]]; then
            echo "Warning: ignoring mount without container path: ${line}" >&2
            continue
        fi

        host_path="${line%%:*}"
        container_spec="${line#*:}"
        container_path="${container_spec%%:*}"
        mode=""
        if [[ "${container_spec}" == *:* ]]; then
            mode="${container_spec#*:}"
        fi

        if [[ "${host_path}" != /* ]]; then
            echo "Warning: ignoring mount with relative host path: ${line}" >&2
            continue
        fi
        if [[ "${container_path}" != /* ]]; then
            echo "Warning: ignoring mount with relative container path: ${line}" >&2
            continue
        fi
        if [[ ! -e "${host_path}" ]]; then
            echo "Warning: ignoring mount with missing host path: ${host_path}" >&2
            continue
        fi
        if [[ -n "${mode}" && "${mode}" != "ro" && "${mode}" != "rw" ]]; then
            echo "Warning: ignoring mount with unsupported mode '${mode}': ${line}" >&2
            continue
        fi

        case "${container_path}" in
            "/"|"/home/hostuser"|"/home/hostuser/.pi"|"/home/hostuser/.pi"/*|"/opt"|"/opt/pi-packages"|"/opt/pi-packages"/*|"${PI_WORK_DIR}"|"${PI_WORK_DIR}"/*)
                echo "Warning: ignoring mount over reserved container path: ${container_path}" >&2
                continue
                ;;
        esac

        DOCKER_ARGS+=(-v "${line}")
    done < "${PI_MOUNTS_FILE}"
}

# ---------------------------------------------------------------------------
# Helper: selektive Datei-Mounts für "pi -m DATEI..."
# ---------------------------------------------------------------------------
add_mount_file() {
    local arg="$1" cwd_real real rel existing
    cwd_real="$(pwd -P)"
    real="$(readlink -f -- "${arg}" 2>/dev/null)" || return 1

    if [[ "${cwd_real}" == "/" ]]; then
        case "${real}" in
            /*) ;;
            *) echo "Error: ${arg} is outside the current directory." >&2; return 1 ;;
        esac
    else
        case "${real}" in
            "${cwd_real}"/*) ;;
            *) echo "Error: ${arg} is outside the current directory." >&2; return 1 ;;
        esac
    fi

    if [[ "${cwd_real}" == "/" ]]; then
        rel="${real#/}"
    else
        rel="${real#"${cwd_real}"/}"
    fi
    if [[ -z "${rel}" || "${rel}" == *:* || "${rel}" == *$'\n'* ]]; then
        echo "Error: ${arg} cannot be mounted (unsupported path)." >&2
        return 1
    fi

    for existing in "${PI_MOUNT_FILE_TARGETS[@]}"; do
        [[ "${existing}" == "${rel}" ]] && return 0
    done

    PI_MOUNT_FILE_HOSTS+=("${real}")
    PI_MOUNT_FILE_TARGETS+=("${rel}")
}

setup_selective_mounts() {
    local hash target
    hash=$(printf '%s\n' "$PWD" "${PI_MOUNT_FILE_TARGETS[@]}" | md5sum | cut -d' ' -f1)

    PI_SELECTIVE=1
    PI_WORK_DIR="/${PROJECT_NAME}_files_${hash: -6}"
    PI_SAFE_WORK_DIR="${PI_WORK_DIR#/}"
    PI_SAFE_WORK_DIR="${PI_SAFE_WORK_DIR//\//-}"
    PI_SAFE_WORK_DIR="${PI_SAFE_WORK_DIR//:/-}"
    PI_SAFE_WORK_DIR="${PI_SAFE_WORK_DIR//\\/-}"
    PI_CONTAINER_NAME="pi-files-${hash}"
    PI_SESSION_MOUNT_NAME="--${PI_SAFE_WORK_DIR}--"
    PI_SESSION_DIR="${PI_AGENT_DIR}/sessions/${PI_SESSION_MOUNT_NAME}"
    mkdir -p "${PI_SELECTIVE_SESSION_PARENT}/${PI_SESSION_MOUNT_NAME}"

    for target in "${PI_MOUNT_FILE_TARGETS[@]}"; do
        mkdir -p "${PI_FILES_ROOT}/$(dirname -- "${target}")"
        : > "${PI_FILES_ROOT}/${target}"
    done
}

# ---------------------------------------------------------------------------
# Helper: festes Pi-Home in mounts.conf sicherstellen
# ---------------------------------------------------------------------------
ensure_home_mount() {
    # Achtung: PI_HOME_DIR erst anlegen, wenn kein User-Eintrag in mounts.conf
    # das Pi-Home already auf ein anderes Host-Verzeichnis zeigt.
    mkdir -p "$(dirname "${PI_MOUNTS_FILE}")" 2>/dev/null || true
    touch "${PI_MOUNTS_FILE}" 2>/dev/null || true
    if [[ ! -f "${PI_MOUNTS_FILE}" ]]; then
        echo "Error: ${PI_MOUNTS_FILE} is not a writable file." >&2
        return 1
    fi

    local line host_path rest target mode
    # shellcheck disable=SC2094
    while IFS= read -r line || [[ -n "${line}" ]]; do
        line="${line%$'\r'}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "${line}" || "${line}" == \#* || "${line}" != *:* ]] && continue

        line="${line/#\~/$HOME}"
        host_path="${line%%:*}"
        rest="${line#*:}"
        target="${rest%%:*}"
        mode=""
        [[ "${rest}" == *:* ]] && mode="${rest#*:}"

        if [[ "${target}" == "${PI_HOME_CONTAINER}" ]]; then
            if [[ "${host_path}" != /* ]]; then
                echo "Warning: Pi home mount has a relative host path: ${line}" >&2
                continue
            fi
            if [[ -n "${mode}" && "${mode}" != "ro" && "${mode}" != "rw" ]]; then
                echo "Warning: Pi home mount has an unsupported mode: ${line}" >&2
                continue
            fi
            if [[ "${host_path}" == "${PI_HOME_OLD_DEFAULT}" && "${PI_HOME_DIR}" != "${PI_HOME_OLD_DEFAULT}" ]]; then
                local tmp
                # shellcheck disable=SC2094
                tmp="$(mktemp "${PI_MOUNTS_FILE}.XXXXXX")" || return 1
                while IFS= read -r l || [[ -n "${l}" ]]; do
                    local ltrim="${l%$'\r'}"
                    ltrim="${ltrim#"${ltrim%%[![:space:]]*}"}"
                    ltrim="${ltrim%"${ltrim##*[![:space:]]}"}"
                    [[ "${ltrim}" == \~/* ]] && ltrim="$HOME/${ltrim#\~/}"
                    if [[ "${ltrim}" == "${line}" ]]; then
                        printf '%s:%s\n' "${PI_HOME_DIR}" "${rest}" >> "${tmp}"
                    else
                        printf '%s\n' "${l}" >> "${tmp}"
                    fi
                done < "${PI_MOUNTS_FILE}"
                chmod --reference="${PI_MOUNTS_FILE}" "${tmp}" 2>/dev/null || true
                # shellcheck disable=SC2094
                if ! mv "${tmp}" "${PI_MOUNTS_FILE}"; then
                    rm -f "${tmp}"
                    return 1
                fi
                mkdir -p "${PI_HOME_DIR}"
                echo "Updated the managed Pi home from ${PI_HOME_OLD_DEFAULT} to ${PI_HOME_DIR}." >&2
                if [[ "${mode}" == "ro" ]]; then
                    echo "Warning: Pi home is mounted read-only (${line}); Pi cannot persist files there." >&2
                fi
                if [[ -e "${PI_HOME_OLD_DEFAULT}" ]]; then
                    echo "Warning: existing data was not moved; it remains at ${PI_HOME_OLD_DEFAULT}." >&2
                fi
                return
            fi
            mkdir -p "${host_path}" 2>/dev/null || true
            if [[ "${mode}" == "ro" ]]; then
                echo "Warning: Pi home is mounted read-only (${line}); Pi cannot persist files there." >&2
            fi
            return
        fi
    done < "${PI_MOUNTS_FILE}"

    mkdir -p "${PI_HOME_DIR}"
    if ! printf '\n# Managed by pi-mono-dockerized: fixed Pi working home\n%s:%s\n' "${PI_HOME_DIR}" "${PI_HOME_CONTAINER}" >> "${PI_MOUNTS_FILE}"; then
        echo "Error: could not add the Pi home mount to ${PI_MOUNTS_FILE}." >&2
        return 1
    fi
}

# ---------------------------------------------------------------------------
# Helper: Initialisierung (Settings, Session-Isolation & Volume)
# ---------------------------------------------------------------------------
bootstrap_environment() {
    local image_id image_stamp
    image_id="$(docker images -q "${PI_IMAGE_NAME}" 2>/dev/null || true)"
    image_stamp=""
    if [[ -n "${image_id}" ]]; then
        image_stamp="$(docker image inspect \
            --format '{{ if .Config.Labels }}{{ index .Config.Labels "pi.build.stamp" }}{{ end }}' \
            "${PI_IMAGE_NAME}" 2>/dev/null || true)"
    fi

    # Fehlendes oder veraltetes Image (Dockerfile/Rust-Version geändert) neu bauen
    if [[ -z "${image_id}" ]]; then
        echo "pi: image ${PI_IMAGE_NAME} is missing; rebuilding."
        echo "pi: global 'docker image prune -a' or 'docker system prune -a' removes it between sessions."
        build_image
    elif [[ "${image_stamp}" != "${PI_BUILD_STAMP}" ]]; then
        echo "pi: image ${PI_IMAGE_NAME} has an old build stamp; rebuilding."
        build_image
    fi

    # 1. Host-Config, festes Pi-Home und Session-Ordner vorbereiten
    mkdir -p "${PI_FOLDER}" "${PI_AGENT_DIR}" "${PI_SESSION_DIR}" "${PI_HOME_SESSION_DIR}"
    # billion-context: persistentes Datenverzeichnis im Pi-Home.
    mkdir -p "${PI_BILI_DATA_DIR}"
    seed_pi_config
    ensure_home_mount

    # 2. Software-Volume für NPM/Python binaries
    docker volume create --label "pi.managed=true" "${PI_GLOBAL_VOLUME}" > /dev/null
    # Fix Permissions im Volume (einmalig)
    docker run --rm -v "${PI_GLOBAL_VOLUME}:/data" busybox chown -R "$(id -u):$(id -g)" /data

    # 3. Pi installieren/aktualisieren (inkl. /share-Migration), Standardpakete installieren
    ensure_pi
    install_default_packages
}

# ---------------------------------------------------------------------------
# Ausführung
# ---------------------------------------------------------------------------
run_pi() {
    local mode="$1"
    shift
    
    bootstrap_environment

    local run_dir session_parent session_dir session_name container_name project_name container_home
    container_home="/home/hostuser"
    [[ "$mode" == "project" ]] && container_home="${PI_HOME_CONTAINER}"
    if [[ "${PI_MOUNT_CWD}" == "1" ]]; then
        run_dir="${PI_WORK_DIR}"
        session_dir="${PI_SESSION_DIR}"
        session_name="${PI_SESSION_MOUNT_NAME}"
        container_name="${PI_CONTAINER_NAME}"
        if [[ "${PI_SELECTIVE}" == "1" ]]; then
            session_parent="${PI_SELECTIVE_SESSION_PARENT}"
            project_name="${PROJECT_NAME}-files"
        else
            session_parent="${PI_SESSION_PARENT}"
            project_name="${PROJECT_NAME}"
        fi
    else
        run_dir="${PI_HOME_CONTAINER}"
        session_parent="${PI_HOME_SESSION_PARENT}"
        session_dir="${PI_HOME_SESSION_DIR}"
        session_name="${PI_HOME_SESSION_NAME}"
        container_name="${PI_HOME_CONTAINER_NAME}"
        project_name="pi-home"
    fi

    # DOCKER_ARGS Array
    DOCKER_ARGS=(
        --rm
        -it
        --network "${PI_NETWORK_MODE}"
        --user "$(id -u):$(id -g)"
        -e "HOME=${container_home}"
        -e "PI_CODING_AGENT_DIR=/home/hostuser/.pi/agent"
        # DER ENTSCHEIDENDE MOUNT: .pi Verzeichnis direkt spiegeln
        -v "${PI_FOLDER}:/home/hostuser/.pi"
        # Das Software-Volume (NPM/Python Pakete)
        -v "${PI_GLOBAL_VOLUME}:/opt/pi-packages"
        # Datenschutz: keine Telemetrie, keine Update-Checks, kein Sentry
        "${PI_TELEMETRY_ENV[@]}"
        # npm-Cache im Volume statt in $HOME
        "${PI_NPM_ENV[@]}"
        # Umgebungsvariablen für das Volume
        # billion-context: persistente Daten- und Konfigurationspfade
        -e "BILI_SESSIONS_DIR=/home/hostuser/.pi/agent/billion-context"
        -e "BILI_CONFIG_FILE=/home/hostuser/.pi/agent/billion-context.json"
        -e "NPM_CONFIG_PREFIX=/opt/pi-packages/npm"
        -e "PYTHONUSERBASE=/opt/pi-packages/python"
        -e "GOPATH=/opt/pi-packages/go"
        -e "PIP_USER=true"
        -e "PIP_BREAK_SYSTEM_PACKAGES=1"
    )

    if [[ "$mode" == "project" ]]; then
        DOCKER_ARGS+=(--name "${container_name}")

        # Sessions: festes Pi-Home oder das aktuelle Projekt.
        DOCKER_ARGS+=(-v "${session_parent}:/home/hostuser/.pi/agent/sessions")
        DOCKER_ARGS+=(-v "${session_dir}:/home/hostuser/.pi/agent/sessions/${session_name}")
        DOCKER_ARGS+=(-e "PI_CODING_AGENT_SESSION_DIR=/home/hostuser/.pi/agent/sessions/${session_name}")
        DOCKER_ARGS+=(-e "PI_PROJECT_NAME=${project_name}")
        [[ -n "${PI_GIT_NAME}" ]] && DOCKER_ARGS+=(-e "GIT_AUTHOR_NAME=${PI_GIT_NAME}" -e "GIT_COMMITTER_NAME=${PI_GIT_NAME}")
        [[ -n "${PI_GIT_EMAIL}" ]] && DOCKER_ARGS+=(-e "GIT_AUTHOR_EMAIL=${PI_GIT_EMAIL}" -e "GIT_COMMITTER_EMAIL=${PI_GIT_EMAIL}")

        # Nur "pi -m" mountet ein Arbeitsverzeichnis. Mit Dateiargumenten
        # werden ausschließlich diese Dateien eingebunden.
        if [[ "${PI_MOUNT_CWD}" == "1" ]]; then
            if [[ "${PI_SELECTIVE}" == "1" ]]; then
                DOCKER_ARGS+=(-v "${PI_FILES_ROOT}:${PI_WORK_DIR}")
                local i
                for ((i = 0; i < ${#PI_MOUNT_FILE_HOSTS[@]}; i++)); do
                    DOCKER_ARGS+=(-v "${PI_MOUNT_FILE_HOSTS[$i]}:${PI_WORK_DIR}/${PI_MOUNT_FILE_TARGETS[$i]}")
                done
            else
                DOCKER_ARGS+=(-v "$(pwd):${PI_WORK_DIR}")

                # Ignores via /dev/null mounts. Mit PI_SHOW_HIDDEN=1 bleibt alles
                # sichtbar; es werden weiterhin nur Projektpfade und mounts.conf-Ziele
                # eingebunden.
                if [[ "${PI_SHOW_HIDDEN}" != "1" ]]; then
                    local -a ignored_files=()
                    for file in "${PI_DEFAULT_IGNORED_FILES[@]}"; do
                        if [[ "${PI_ALLOW_GIT}" == "1" && ( "$file" == ".git" || "$file" == ".gitignore" || "$file" == ".gitmodules" ) ]]; then
                            continue
                        fi
                        ignored_files+=("$file")
                    done

                    # .pi/APPEND_SYSTEM.md und .pi/SYSTEM.md bleiben sichtbar.
                    if [[ -d "./.pi" ]]; then
                        for file in APPEND_SYSTEM.md SYSTEM.md; do
                            [[ -f "./.pi/$file" ]] && cp "./.pi/$file" "${PI_PROJECT_PI_DIR}/$file"
                        done
                    fi

                    for file in "${ignored_files[@]}"; do
                        if [[ -d "./$file" ]]; then
                            if [[ "$file" == ".pi" ]]; then
                                DOCKER_ARGS+=(-v "${PI_PROJECT_PI_DIR}:${PI_WORK_DIR}/.pi")
                            else
                                DOCKER_ARGS+=(-v "${PI_EMPTY_DIR}:${PI_WORK_DIR}/$file")
                            fi
                        elif [[ -f "./$file" ]]; then
                            DOCKER_ARGS+=(-v "/dev/null:${PI_WORK_DIR}/$file")
                        fi
                    done
                fi
            fi
        fi

        # API Keys durchreichen
        for key in "${PI_API_KEY_FILES[@]}"; do
            key_file="${PI_DOCKER_CONFIG_ROOT}/$key"
            [[ -f "$key_file" ]] && DOCKER_ARGS+=(-e "$key=$(cat "$key_file")")
        done

        # Zusätzliche permanente Mounts aus ~/.pi/mounts.conf
        add_extra_mounts

        docker rm -f "${container_name}" 2>/dev/null || true
    fi

    # Startbefehl: Argumente werden als echte Argumente übergeben, nicht in
    # einen Shell-String interpoliert. So bleiben Leerzeichen und Quotes in
    # Prompts erhalten.
    if [[ "$mode" == "project" ]]; then
        # Projekt-Trust standardmäßig aus: keine projekt-eigenen Extensions/Skills.
        # Ein explizites --approve/-a in den Pi-Argumenten hebt das für diesen
        # Aufruf bewusst auf.
        local approve_flag="--no-approve"
        for arg in "$@"; do
            if [[ "$arg" == "--approve" || "$arg" == "-a" ]]; then
                approve_flag=""
                break
            fi
        done
        docker run "${DOCKER_ARGS[@]}" "${PI_IMAGE_NAME}" \
            /bin/sh -c "cd \"\$1\" && shift && exec pi ${approve_flag} \"\$@\"" pi "${run_dir}" "$@"
    else
        docker run "${DOCKER_ARGS[@]}" "${PI_IMAGE_NAME}" \
            /bin/sh -c 'exec pi "$@"' pi "$@"
    fi
}

# --- Routing ---
PI_COMMAND="${1:-}"
while [[ -n "${PI_COMMAND}" ]]; do
    case "${PI_COMMAND}" in
        -m|--mount)
            PI_MOUNT_CWD=1
            shift
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --)
                        shift
                        break
                        ;;
                    -*)
                        break
                        ;;
                    web)
                        # "web" ist der Web-UI-Shortcut, kein Dateipfad.
                        # Ein Projekt-Ordner/eine Datei namens "web" lässt
                        # sich mit ./web explizit mounten.
                        break
                        ;;
                esac
                if [[ -d "$1" ]]; then
                    echo "Error: 'pi -m $1' is not supported. Use 'pi -m' without file arguments for the whole directory." >&2
                    exit 1
                fi
                if [[ -f "$1" ]]; then
                    add_mount_file "$1" || exit 1
                    shift
                    continue
                fi
                break
            done
            if (( ${#PI_MOUNT_FILE_HOSTS[@]} > 0 )); then
                setup_selective_mounts
            fi
            PI_COMMAND="${1:-}"
            ;;
        --show-hidden|show-hidden)
            PI_SHOW_HIDDEN=1
            shift
            PI_COMMAND="${1:-}"
            ;;
        rebuild)
            docker rmi "${PI_IMAGE_NAME}" 2>/dev/null || true
            shift
            PI_COMMAND="${1:-}"
            ;;
        *)
            break
            ;;
    esac
done

# Shortcut: Pi starten und direkt den /web-Extension-Command ausführen.
# Funktioniert auch in Kombination mit den Pi-Session-Flags -c/-r
# (z. B. "pi -m -c web" = letzte Projekt-Session fortsetzen und Web UI öffnen).
PI_WEB_FLAGS=()
PI_WEB_SCAN="${PI_COMMAND}"
case "${PI_WEB_SCAN}" in
    -c|--continue|-r|--resume)
        PI_WEB_FLAGS=("${PI_WEB_SCAN}")
        PI_WEB_SCAN="${2:-}"
        ;;
esac
if [[ "${PI_WEB_SCAN}" == "web" ]]; then
    if (( ${#PI_WEB_FLAGS[@]} > 0 )); then
        shift
    fi
    shift
    run_pi "project" "/web" ${PI_WEB_FLAGS[@]+"${PI_WEB_FLAGS[@]}"} "$@"
    exit $?
fi

PI_CONFIG_COMMANDS="install remove uninstall update list config auth mcp"
for cmd in $PI_CONFIG_COMMANDS; do
    if [[ "${PI_COMMAND}" == "$cmd" ]]; then
        run_pi "config" "$@"
        exit $?
    fi
done

run_pi "project" "$@"